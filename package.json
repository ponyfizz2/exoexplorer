{
  "name": "exoexplorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EXOEXPLORER — an immersive, real-data explorer for all 6,000+ confirmed exoplanets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "fetch:snapshot": "node scripts/build-fallback.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
